# ---------------------------------------------------------------------------
# ZapCastSat AI backend configuration. Copy to .env and adjust.
# Never commit real secrets. Nothing in this file is sent to the browser.
# ---------------------------------------------------------------------------
ENVIRONMENT=development

# Database. SQLite works out of the box for local development.
# Production (Supabase): postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./zapcastsat_dev.db

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# --- Authentication ---------------------------------------------------------
# local    = backend issues its own JWTs (email + password, argon2 hashed)
# supabase = backend verifies Supabase Auth access tokens
AUTH_PROVIDER=local
# Required in production when AUTH_PROVIDER=local (32+ random bytes)
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=10080

# Supabase (only for AUTH_PROVIDER=supabase and/or STORAGE_PROVIDER=supabase)
SUPABASE_URL=
# Legacy HS256 JWT secret. Leave empty to verify via the project's JWKS (asymmetric keys).
SUPABASE_JWT_SECRET=
# Service role key — server-side only, used for Storage uploads.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# --- File storage -------------------------------------------------------------
# local = files saved under LOCAL_UPLOAD_DIR and served at /uploads
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8000
MAX_UPLOAD_BYTES=5242880

# --- AI -----------------------------------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint with tool calling.
# Leave LLM_API_KEY empty to run the assistant in clearly-labelled OFFLINE mode
# (deterministic Azerbaijani/English command parser, same tools & confirmation flow).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
AI_DAILY_MESSAGE_LIMIT=200
AI_MAX_TOOL_ITERATIONS=4

# --- Rate limiting (per process) ----------------------------------------------
RATE_LIMIT_PER_MINUTE=120
AI_RATE_LIMIT_PER_MINUTE=20

# --- Realtime notifications (message queue + Server-Sent Events) ---
# Events wait in the queue up to this long so bursts go out as one batch (max 5000 = the 5 s delivery limit).
REALTIME_FLUSH_MS=1000
REALTIME_QUEUE_MAX=100000
REALTIME_MAX_STREAMS_PER_USER=5
# Empty: in-process queue, fine for ONE API instance. With several instances set Redis so all of them
# receive every event, e.g. redis://localhost:6379/0 (Render Key Value / Upstash also work).
REDIS_URL=

# --- Monitoring (optional) ----------------------------------------------------
# SENTRY_DSN=
